NODE_ENV=development
PORT=3000

# Database (supports both naming conventions)
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_SERVER=localhost
DB_DATABASE=AlumniManagement
# Alternative env var names also accepted:
# DB_USERNAME, DB_HOST, DB_NAME
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MIN=2
DB_POOL_MAX=10

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-at-least-32-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Comma-separated browser origins; same-origin requests work without this value.
CORS_ORIGIN=https://alumni.mzcet.in
LOG_LEVEL=info
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
LOGIN_RATE_LIMIT_MAX=12
RATE_LIMIT_MAX=300

# Automation Security Secret (generate via `openssl rand -hex 32`, never commit the real value)
N8N_SHARED_SECRET=
AMS_BASE_URL=https://alumni.mzcet.in
N8N_CAMPAIGN_WEBHOOK_URL=http://103.207.1.91:5678/webhook/ams-campaign-send

