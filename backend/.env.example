NODE_ENV=development
PORT=3000

# Database (supports both naming conventions)
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_SERVER=localhost
DB_DATABASE=AlumniManagement
# Alternative env var names also accepted:
# DB_USERNAME, DB_HOST, DB_NAME
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MIN=2
DB_POOL_MAX=10

JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=change-this-to-another-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

CORS_ORIGIN=*
LOG_LEVEL=info
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800

# Automation Security Secret (generate via `openssl rand -hex 32`, never commit the real value)
N8N_SHARED_SECRET=
N8N_CAMPAIGN_WEBHOOK_URL=

